# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# WARNING: service role key bypasses RLS — backend only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── LLM providers ────────────────────────────────────────────────────────────
# Groq (primary): https://console.groq.com — free, no credit card needed
GROQ_API_KEY=your-groq-api-key
# Gemini (fallback): https://aistudio.google.com — free tier
GEMINI_API_KEY=your-gemini-api-key
# Switch primary provider: "groq" | "gemini"
LLM_PROVIDER=groq

# ── Frontend (Vite requires VITE_ prefix to expose vars to the browser) ───────
# In production, set VITE_API_URL to your Render backend URL (not localhost!)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Runtime ───────────────────────────────────────────────────────────────────
# dev | staging | prod
ENVIRONMENT=dev
